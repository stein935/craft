#!/usr/bin/env bash

# Bits
ring_bell() { [ -t 1 ] && printf "\a"; }

# string formatters
tty_escape() { printf "\033[%sm" "$1"; } || tty_escape() { :; }

strip_ansi() {
	# Reads from stdin and outputs to stdout
	sed -r 's/\x1B\[[0-9;]*[mK]//g'
}

form() {

	# ANSI color codes
	local -A color=(
		[black]=0
		[red]=1
		[green]=2
		[yellow]=3
		[blue]=4
		[magenta]=5
		[cyan]=6
		[white]=7
		[normal]=9
	)

	# ANSI text format codes
	local -A style=(
		[normal]=0
		[bold]=1
		[dim]=2
		[italic]=3
		[underline]=4
		[blink]=5
		[reverse]=7
		[hidden]=8
	)

	local color_name \
		start \
		reset

	local -i bright

	if [[ $1 == bright_* ]]; then
		bright=60
		color_name=${1#bright_}
	else
		bright=0
		color_name=$1
	fi

	local -i color_code="${color[$color_name]}" \
		style_code="${style[$2]}"

	start="$(tty_escape "$style_code;$((bright + 30 + color_code))")"
	reset="$(tty_escape 0)"
	printf "${start}%s${reset}" "$3"

}

shell_join() {

	printf "%s" "$1"
	shift
	local arg
	for arg in "$@"; do
		printf " "
		printf "%s" "${arg// /\ }"
	done

}

version_ge() {

	# Returns 0 if $1 >= $2, 1 otherwise
	[ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" = "$2" ]

}

abort() {

	printf "%s\n" "$(warn "$@")" >&2
	exit 1

}

execute() {

	if ! "$@"; then
		abort "$(printf "Failed during: %s" "$(shell_join "$@")")"
	fi

}

fwhip() {

	printf '%s %s\n\n' "$(form bright_blue normal "▶")" "$@"

}

warn() {

	printf '%s %s\n\n' "$(form bright_red normal "✕")" "$@"

}

send() {

	printf '%s %s\n\n' "$(form bright_yellow normal "")" "$@"

}

indent() {

	local -i space_count=${2:-4}

	local spaces \
		i

	for ((i = 0; i < space_count; i++)); do
		spaces+=" "
	done

	printf "%s%s\n" "$spaces" "$1"

}

rm_line() {

	printf "\033[1A\033[2K"

}

test_form() {

	# Usage: test_form <assoc_array_name>
	# Pass the NAME of the associative array, not its expanded contents.
	# Requires bash >= 4 for associative arrays and >= 4.3 for nameref (declare -n).
	local name="$1"
	# Nameref to the associative array
	local -n _map="$name"

	# Determine maximum key width for alignment
	local max=0 \
		k
	for k in "${!_map[@]}"; do
		((${#k} > max)) && max=${#k}
	done
	# Sort keys for stable output
	while IFS= read -r k; do
		local v=${_map[$k]} \
			plain_key=$k \
			colored_key
		colored_key=$(form yellow normal "$plain_key")

		# Spaces needed after the colored key
		local pad=$((max - ${#plain_key}))
		((pad < 0)) && pad=0

		# Build line: colored_key + pad spaces + " : " + value
		printf '%s%*s : %s\n' "$colored_key" "$pad" '' "$(form normal normal "$v")"
	done < <(printf '%s\n' "${!_map[@]}")

	echo

}

test_desc_form() {

	local type \
		comment

	$1 && type="green" || type="red"

	[[ -n "$3" ]] && comment="$(form yellow dim "# $3")"

	indent "$(form $type normal "") $(form cyan dim "$2") $comment" 12 >&3

}

check_output() {

	[[ "$(echo "$2" | strip_ansi)" == *"$1"* ]]

}

number() {

	form blue normal "$BATS_TEST_NUMBER"

}

use_fzf() {

	local prompt="$1" \
		choice

	if command -v fzf >/dev/null 2>&1; then
		# shellcheck disable=SC2016
		fzf --style full \
			--height 40% \
			--layout=reverse \
			--padding 1,2 \
			--input-label ' Select ' \
			--bind 'result:transform-list-label:
            if [[ -z $FZF_QUERY ]]; then
              echo " $FZF_MATCH_COUNT items "
            else
              echo " $FZF_MATCH_COUNT matches for [$FZF_QUERY] "
            fi
            ' \
			--bind 'ctrl-r:change-list-label( Reloading the list )+reload(sleep 2; git ls-files)' \
			--color 'list-border:green,list-label:bright-green' \
			--color 'input-border:cyan,input-label:bright-cyan' \
			--color 'pointer:yellow' \
			--color 'prompt:cyan' \
			--prompt=" $prompt: "
	else
		# Fallback to bash built-in select
		local -a items
		while IFS= read -r line; do
			items+=("$line")
		done

		if [[ ${#items[@]} == 0 ]]; then
			warn "No items to select from"
			return 1
		fi

		select choice in "${items[@]}" "Cancel"; do
			if [[ "$choice" == "Cancel" ]]; then
				return 1
			elif [[ -n "$choice" ]]; then
				echo "$choice"
				break
			else
				warn "Invalid selection. Please try again."
			fi
		done </dev/tty # <-- Add this to read from terminal
	fi

}

min_sec() { printf "%dm %ds" "$((10#$1 / 60))" "$((10#$1 % 60))"; }

# Errors and help
replace_alias_args() {

	local -n arr="$1"
	shift
	local -a out=()

	for arg in "$@"; do
		local found=false \
			alias
		for alias in "${!arr[@]}"; do
			local replacement=${arr[$alias]}
			if [[ "$arg" == "$alias" ]]; then
				out+=("$replacement")
				found=true
				break
			fi
		done
		! $found && out+=("$arg")
	done
	printf '%s\n' "${out[@]}"

}

command_help() {

	local -i exit_code=$2
	local command="$1"

	printf '%s\n\n' "$(form cyan normal "$(cat "${CRAFT_HOME_DIR}/config/help/${command}_help.txt")")"
	exit $exit_code

}

missing_argument() {

	warn "Missing argument: -$2 requires an argument"
	command_help "$1" 1

}

invalid_command() {

	warn "Invalid command: $2"
	command_help "$1" 1

}

invalid_option() {

	warn "Invalid option: -$2"
	command_help "$1" 1

}

missing_required_option() {

	warn "Missing option: $1 requires \"$2\""
	command_help "$1" 1

}

runtime() {

	local time
	time=$(min_sec $(($(date +%s) - $START)))
	indent "$(form yellow normal "Runtime: $time")"

}

players() {

	local status \
		online \
		max \
		players \
		string

	status=$(mcstatus "127.0.0.1:${SERVER_PORT}" json)
	online=$(echo "$status" | jq -r '.status.players.online')
	max=$(echo "$status" | jq -r '.status.players.max')
	readarray -t players < <(echo "$status" | jq -r '.status.players.sample // [] | .[].name' | sort -u)

	[[ "$max" == "null" ]] && return # Offline mode servers do not report max players

	[[ $online -gt 0 ]] && string=": $(form green normal "${players[@]// /, }")" || string=""
	printf ', Players [%s/%s]%s\n' "$online" "$max" "$string"

}

server_on() {

	local -i seconds
	seconds=${1:-20}

	local pipe \
		PID

	for ((i = 0; i <= seconds; i++)); do
		PID=$(lsof -i :"$SERVER_PORT" | grep "$SERVER_PORT (LISTEN)" | awk '{print $2}')
		export PID
		[[ -n "$PID" ]] && pipe=$(lsof -p "$PID" | grep "${SERVER_NAME}/command-pipe" | awk '{print $2}')
		if [[ -n "$PID" ]] && [[ -n "$pipe" ]] && [[ "$PID" == "$pipe" ]]; then
			fwhip "$(form bright_cyan italic "\"${SERVER_NAME}\"") Minecraft server running on port: $(form green normal "$SERVER_PORT"), PID: $(form green normal "$PID")$(players)"
			return 0
		else
			[[ $i != 0 ]] && sleep 1
		fi
	done
	warn "$(form bright_cyan italic "\"${SERVER_NAME}\"") is not running"
	return 1

}

server_off() {

	local -i seconds
	seconds=${1:-20}

	local PID

	for ((i = 0; i <= seconds; i++)); do
		PID=$(lsof -i :"$SERVER_PORT" | grep "$SERVER_PORT (LISTEN)" | awk '{print $2}')
		export PID
		if ! [[ -n "$PID" ]]; then
			warn "$(form bright_cyan italic "\"${SERVER_NAME}\"") is not running"
			return 0
		else
			! [[ $i == 0 ]] && sleep 1
		fi
	done
	fwhip "$(form bright_cyan italic "\"${SERVER_NAME}\"") Minecraft server running on port: $(form green normal "$SERVER_PORT") PID: $(form green normal "$PID")"
	return 1

}

list_properties() {

	local prop \
		file=$1
	local -i count=0

	while IFS="" read -r line || [[ -n "$line" ]]; do
		if [[ $count -gt 1 ]]; then
			prop="${line%=*}"
			prop="${prop//-/_}"
			prop="${prop//./_}"
			prop="${prop^^}"
			local set="${line##*=}"
			export "$prop"="$set"
		fi
		((count++))
	done <"${file}"

}

get_properties() {

	list_properties "${CRAFT_SERVER_DIR}/${SERVER_NAME}/server.properties"
	list_properties "${CRAFT_SERVER_DIR}/${SERVER_NAME}/fabric-server-launcher.properties"

}

find_server() {

	if ! [[ -d "${CRAFT_SERVER_DIR}/$SERVER_NAME" ]]; then
		warn "Server not found: $SERVER_NAME"
		exit 1
	fi

}

check_java() {

	local game=$1 \
		java_version \
		required_java \
		found_java

	if ! command -v java >/dev/null 2>&1; then
		echo "Java is not installed."
		exit 1
	fi

	java_version=$(java -version 2>&1 | awk -F '"' '/version/ {print $2}' | cut -d. -f1)

	# Determine required Java version
	if version_ge "$game" "1.20.5"; then
		required_java=21
	elif version_ge "$game" "1.18.2"; then
		required_java=17
	elif version_ge "$game" "1.17.2"; then
		required_java=16
	else
		required_java=8
	fi

	if [[ "$java_version" -eq "$required_java" ]]; then
		return 0
	else
		found_java=$(/usr/libexec/java_home -V 2>&1 | grep -E " $required_java(\.|$)")
		if [[ -z "$found_java" ]]; then
			warn "Required Java $required_java not found via /usr/libexec/java_home."
			return 1
		fi
		JAVA_HOME=$(/usr/libexec/java_home -v "$required_java")
		export JAVA_HOME
		export PATH="$JAVA_HOME/bin:$PATH"
		warn "Minecraft $game requires Java $required_java; overriding detected Java $java_version"
		return 0
	fi

}

discord_message() {

	message() {
		cat <<-EOF
			{
			  "embeds":[{
			    "title": "${1}",
			    "description":"${2}",
			    "timestamp":"$(date +'%Y-%m-%dT%H:%M:%S%z')",
			    "color":"${3}",
			    "author":{
			      "name":"Craft CLI - ${4}",
			      "url":"https://github.com/stein935/craft"
			    }
			  }]
			}
		EOF
	}

	# POST request to Discord Webhook
	curl -H "Content-Type: application/json" -X POST -d "$(message "$1" "$2" "$3" "$4")" "${DISCORD_WEBHOOK}" &>/dev/null

}

boolean() {

	case $1 in
	true) echo true ;;
	false) echo false ;;
	*) echo true ;;
	esac

}

# box() - Draw a text box with optional label and word wrapping
#
# Usage:
#   box "text content" ["label"] [max_width]
#
# Parameters:
#   $1 - body: Text content to display in the box (required)
#   $2 - label: Label to display in top border (optional)
#   $3 - max_width: Maximum line length for text wrapping (optional, defaults to auto-fit)
#
# Examples:
#   box "Server started successfully"
#   box "Error: Configuration file not found" "Warning"
#   box "Long text that will be wrapped to fit within the specified width" "Info" 40
#   box "$(box "$(test_form test_info)" "Test")" "Test"  # Multi-line input preserved
#
# Box Characters: ─ │ ┌ ┐ └ ┘
box() {

	local body="$1" \
		label="$2" \
		max_width="${3:-0}" \
		line \
		word \
		current_line="" \
		border_top \
		border_bottom

	local -a lines=() \
	words

	local -i text_padding=2 \
		content_width=0 \
		box_width=0 \
		label_len=0 \
		i

	# Check if body contains newlines (multi-line input)
	if [[ "$body" == *$'\n'* ]]; then
		# Multi-line input: preserve lines and strip ANSI codes for width calculation
		while IFS= read -r line; do
			lines+=("$line")
			# Calculate width without ANSI codes
			local plain_line
			plain_line=$(echo "$line" | strip_ansi)
			((${#plain_line} > content_width)) && content_width=${#plain_line}
		done <<<"$body"
	else
		# Single-line input: apply word wrapping
		read -ra words <<<"$body"

		# Calculate content width if max_width not specified
		if [[ $max_width -eq 0 ]]; then
			# Find longest word to ensure box can fit it
			local -i longest_word=0
			for word in "${words[@]}"; do
				((${#word} > longest_word)) && longest_word=${#word}
			done

			# Auto-fit: use length of entire text or 60, whichever is smaller
			# But ensure it's at least as wide as the longest word
			max_width=${#body}
			((max_width > 60)) && max_width=60
			((max_width < longest_word)) && max_width=$longest_word
		fi

		# Word wrap the text
		for word in "${words[@]}"; do
			if [[ -z "$current_line" ]]; then
				current_line="$word"
			elif ((${#current_line} + ${#word} + 1 <= max_width)); then
				current_line+=" $word"
			else
				lines+=("$current_line")
				((${#current_line} > content_width)) && content_width=${#current_line}
				current_line="$word"
			fi
		done

		# Add the last line
		if [[ -n "$current_line" ]]; then
			lines+=("$current_line")
			((${#current_line} > content_width)) && content_width=${#current_line}
		fi
	fi

	# Calculate box width (content + padding on both sides + borders)
	box_width=$((content_width + (text_padding * 2) + 2))

	# Build top border
	if [[ -n "$label" ]]; then
		label_len=${#label}
		border_top="┌──${label}"
		# Fill remaining width with horizontal lines
		for ((i = 0; i < box_width - label_len - 4; i++)); do
			border_top+="─"
		done
		border_top+="┐"
	else
		border_top="┌"
		for ((i = 0; i < box_width - 2; i++)); do
			border_top+="─"
		done
		border_top+="┐"
	fi

	# Build bottom border
	border_bottom="└"
	for ((i = 0; i < box_width - 2; i++)); do
		border_bottom+="─"
	done
	border_bottom+="┘"

	# Output the box
	printf '%s\n' "$border_top"

	# Empty line at top
	printf '│'
	for ((i = 0; i < box_width - 2; i++)); do
		printf ' '
	done
	printf '│\n'

	# Content lines
	for line in "${lines[@]}"; do
		# Calculate padding using plain text length (without ANSI codes)
		local plain_line
		plain_line=$(echo "$line" | strip_ansi)
		local -i padding_right=$((content_width - ${#plain_line}))
		printf '│'
		# Left padding
		for ((i = 0; i < text_padding; i++)); do
			printf ' '
		done
		printf '%s' "$line"
		# Right padding to align box edges
		for ((i = 0; i < padding_right + text_padding; i++)); do
			printf ' '
		done
		printf '│\n'
	done

	# Empty line at bottom
	printf '│'
	for ((i = 0; i < box_width - 2; i++)); do
		printf ' '
	done
	printf '│\n'

	printf '%s\n' "$border_bottom"

}
