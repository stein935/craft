#!/usr/bin/env bash

# Compatibility wrapper for lib/common
# Sources all utility modules in dependency order

# Ensure CRAFT_LIB is set (should be exported by bin/craft)
if [[ -z "$CRAFT_LIB" ]]; then
	echo "Error: CRAFT_LIB not set" >&2
	exit 1
fi

# Source utility modules in dependency order
# core: no dependencies (foundation)
source "${CRAFT_LIB}/utils/core"

# output: depends on core
source "${CRAFT_LIB}/utils/output"

# errors: depends on core, output
source "${CRAFT_LIB}/utils/errors"

# test: depends on core, output
source "${CRAFT_LIB}/utils/test"

# server: depends on core, output
source "${CRAFT_LIB}/utils/server"
