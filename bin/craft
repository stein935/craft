#!/usr/bin/env bash

main() {

	local craft_file_directory \
		craft_file \
		args \
		new_args \
		COMMAND \
		fun

	local -A alias_map

	local START \
		CRAFT_HOME_DIR \
		CRAFT_LIB \
		CRAFT_SERVER_DIR

	START="$(date +%s)"

	quiet_cd() {
		cd "$@" &>/dev/null || return
	}

	# Check bash version (requires 4.3+ for nameref support)
	if [[ "${BASH_VERSINFO[0]}" -lt 4 ]] || [[ "${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -lt 3 ]]; then
		help() {
			echo "Current version: ${BASH_VERSION}" >&2
			echo "On macOS, you can install a newer version of bash using Homebrew:" >&2
			indent "brew install bash" >&2
		}
		warn "Craft CLI requires bash 4.3 or higher" >&2
		box "$(help)" "error" "Bash Version Error" >&2
		exit 1
	fi

	# Env variables
	craft_file_directory="$(quiet_cd "${0%/*}/" && pwd -P)"
	craft_file="${craft_file_directory%/}/${0##*/}"

	CRAFT_HOME_DIR="${craft_file%/*/*}"
	CRAFT_LIB="${CRAFT_HOME_DIR}/lib"
	CRAFT_SERVER_DIR="/opt/craft/servers"

	# Export CRAFT_LIB before loading common (needed by utility modules)
	export START \
		CRAFT_HOME_DIR \
		CRAFT_LIB \
		CRAFT_SERVER_DIR

	# Load common functions
	# shellcheck source=lib/common
	source "${CRAFT_LIB}/common"

	# Check for aliases
	args=("$@")

	# shellcheck disable=SC2034
	alias_map=(
		["--help"]="-h"
		["--list"]="-ls"
		["--version"]="-v"
	)
	new_args=()
	while IFS= read -r line; do
		new_args+=("$line")
	done < <(replace_alias_args alias_map "${args[@]}")

	set -- "${new_args[@]}"

	# Command variable
	COMMAND=$(basename "$0")
	fun="$1"

	echo

	# Look for command
	[[ -z "$fun" ]] && command_help "$COMMAND" 1

	# Execute command
	shift

	# Validate command name to avoid sourcing unexpected files
	if [[ "$fun" =~ ^[A-Za-z0-9_-]+$ ]] && [[ -f "${CRAFT_LIB}/$fun" ]]; then
		export COMMAND="$fun"
		# shellcheck disable=SC1090  # dynamic but validated file name
		source "${CRAFT_LIB}/$fun"
		"${fun}"_command "$@"
	else
		invalid_command "$COMMAND" "${fun}"
	fi

}

main "$@"
